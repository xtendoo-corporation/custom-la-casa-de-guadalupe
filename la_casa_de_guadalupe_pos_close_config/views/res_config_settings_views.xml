<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.close.pin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="PIN de Cierre de Caja" help="Requerir un PIN de seguridad para poder cerrar la sesión de esta caja.">
                    <field name="pos_pos_close_pin" password="True"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
